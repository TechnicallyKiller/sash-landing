# ---- Database (waitlist storage) ----------------------------------------
# Vercel Postgres / Neon / Supabase connection string.
# Without it the app still runs; signups are kept in memory only and warn in logs.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# ---- Site --------------------------------------------------------------
# Canonical URL, used for metadata and OG tags.
NEXT_PUBLIC_SITE_URL="https://sash.vercel.app"

# ---- Optional: notification email on each signup ------------------------
# Leave unset to disable. Uses the Resend API.
RESEND_API_KEY=""
SIGNUP_NOTIFY_TO=""
